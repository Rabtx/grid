{
	"name": "Grid",
	"dockerComposeFile": "compose.yml",
	"service": "grid",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"shutdownAction": "stopCompose",

	// Tailscale, so a home Grid can pair with this Codespace over your tailnet (see README.md).
	// It only joins when a TS_AUTH_KEY Codespaces secret exists; otherwise it stays idle.
	"features": {
		"ghcr.io/tailscale/codespace/tailscale": {}
	},

	"postCreateCommand": "bun install && bun run prepare",
	// Grid starts in the background on attach (a second start exits: it is already running).
	// Its log is .grid/grid.log.
	"postAttachCommand": "mkdir -p .grid && setsid nohup bun run grid > .grid/grid.log 2>&1 &",
	"forwardPorts": [8080, 3000, 3002, 4000],
	"portsAttributes": {
		"8080": {
			"label": "Grid",
			"onAutoForward": "openBrowser"
		},
		"3000": {
			"label": "Web (Next.js)",
			"onAutoForward": "notify"
		},
		"3002": {
			"label": "Docs",
			"onAutoForward": "silent"
		},
		"4000": {
			"label": "Nest API",
			"onAutoForward": "silent"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"oxc.oxc-vscode",
				"bradlc.vscode-tailwindcss",
				"rust-lang.rust-analyzer",
				"ms-python.python",
				"charliermarsh.ruff",
				"timonwong.shellcheck",
				"mkhl.shfmt"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "oxc.oxc-vscode",
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer"
				},
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},

	"remoteUser": "vscode"
}
