{
	"name": "Grid",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},

	"features": {
		// Tailscale, so a home Grid can pair with this Codespace over your tailnet (see README.md).
		// It only joins when a TS_AUTH_KEY Codespaces secret exists; otherwise it stays idle.
		"ghcr.io/tailscale/codespace/tailscale": {},
		// An SSH server, so `gh codespace ssh` reaches the container (scripts, debugging).
		"ghcr.io/devcontainers/features/sshd:1": {},
		// Keeps Grid running for the container's lifetime (see grid-service/entrypoint.sh).
		"./grid-service": {}
	},
	// Tailscale's kernel networking needs a tun device.
	"runArgs": ["--device=/dev/net/tun"],

	"containerEnv": {
		// Grid's own database, started by start.sh inside this container.
		"DATABASE_URL": "postgresql://grid:grid@localhost:5432/grid",
		// Pair with a home Grid whenever this Codespace is on a tailnet (it stays on loopback when not).
		"GRID_PAIRING": "1",
		// Where the grid-service feature runs Grid from.
		"GRID_WORKSPACE": "${containerWorkspaceFolder}"
	},

	"postCreateCommand": "bun install && bun run prepare",
	// The tailnet and Postgres; then grid-service starts Grid (port 8080, log in .grid/grid.log).
	"postStartCommand": "bash .devcontainer/start.sh",
	"forwardPorts": [8080, 3000, 3002, 4000],
	"portsAttributes": {
		"8080": {
			"label": "Grid",
			"onAutoForward": "openBrowser"
		},
		"3000": {
			"label": "Web (Next.js)",
			"onAutoForward": "notify"
		},
		"3002": {
			"label": "Docs",
			"onAutoForward": "silent"
		},
		"4000": {
			"label": "Grid API",
			"onAutoForward": "silent"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"oxc.oxc-vscode",
				"bradlc.vscode-tailwindcss",
				"rust-lang.rust-analyzer",
				"ms-python.python",
				"charliermarsh.ruff",
				"timonwong.shellcheck",
				"mkhl.shfmt"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "oxc.oxc-vscode",
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer"
				},
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},

	"remoteUser": "vscode"
}
