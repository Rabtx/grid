{
	"name": "@grid/db",
	"version": "0.0.0",
	"private": true,
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./instance": "./src/instance.ts",
		"./password": "./src/password.ts",
		"./roles": "./src/roles.ts",
		"./workspaces": "./src/workspaces.ts"
	},
	"scripts": {
		"generate": "bun --env-file=../../apps/api/.env x drizzle-kit generate",
		"migrate": "bun --env-file=../../apps/api/.env src/migrate.ts",
		"seed": "bun --env-file=../../apps/api/.env src/seed.ts",
		"studio": "bun --env-file=../../apps/api/.env x drizzle-kit studio",
		"lint": "oxlint .",
		"typecheck": "tsc --noEmit",
		"test": "bun test src"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-socket": "^0.2.11",
		"drizzle-orm": "^0.45.3"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.3"
	}
}
