{
	"name": "@grid/ui",
	"version": "0.0.0",
	"private": true,
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./hooks/*": "./src/hooks/*.ts",
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@hugeicons/core-free-icons": "^4.1.4",
		"@hugeicons/react": "^1.1.6",
		"@shadcn/react": "^0.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"motion": "^12.42.2",
		"react-day-picker": "^10.0.1",
		"react-resizable-panels": "^4.12.2",
		"recharts": "3.8.0",
		"tailwind-merge": "^3.6.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@grid/typescript-config": "workspace:*",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	}
}
