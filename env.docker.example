# Docker Compose env. Copy to .env and adjust.
# Used by: docker compose (postgres, api, web). Fragments: docker/compose/*.yml

# Postgres
POSTGRES_USER=grid
POSTGRES_PASSWORD=grid
POSTGRES_DB=grid
POSTGRES_PORT=5433

# Grid API (required secrets must be 32+ chars in production)
API_PORT=4000
JWT_SECRET=development-only-jwt-secret-change-me-now
AUTH_TOKEN_SECRET=development-only-auth-token-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
AUTH_DEV_EXPOSE_CODES=false
AUTH_EMAIL_FROM=Grid <auth@example.com>
# Required when NODE_ENV=production (use a real Resend key in real deploys)
RESEND_API_KEY=re_local_dev_placeholder_not_for_prod
RUN_MIGRATIONS=true
TRUST_PROXY=false
DATABASE_POOL_MAX=10

# Next.js web (browser calls the published API port on the host)
WEB_PORT=3000
# The name is a leftover from the NestJS API this replaced; the value is the Grid API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Absolute origin for OG/canonical/sitemap/robots (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
