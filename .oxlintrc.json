{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["unicorn", "typescript", "oxc", "import", "react", "jsx-a11y", "nextjs"],
	"categories": {
		"correctness": "warn"
	},
	"ignorePatterns": ["**/.next", "**/dist", ".agents"],
	"rules": {
		"react/exhaustive-deps": "warn",
		"react/rules-of-hooks": "error",
		"react/no-array-index-key": "error",
		"react/no-danger": "error",
		"nextjs/no-img-element": "warn",
		"nextjs/no-head-element": "warn",
		"nextjs/no-document-import-in-page": "error",
		"nextjs/no-head-import-in-document": "error",
		"nextjs/google-font-display": "warn",
		"nextjs/no-async-client-component": "warn",
		"nextjs/no-before-interactive-script-outside-document": "off",
		"unicorn/prefer-node-protocol": "warn",
		"unicorn/no-document-cookie": "warn",
		"typescript/no-explicit-any": "warn",
		"typescript/consistent-type-imports": "warn",
		"typescript/no-floating-promises": "off",
		"typescript/no-misused-promises": "off",
		"jsx_a11y/label-has-associated-control": "error",
		"jsx_a11y/role-supports-aria-props": "error",
		"jsx_a11y/interactive-supports-focus": "error",
		"jsx_a11y/click-events-have-key-events": "error",
		"jsx_a11y/prefer-tag-over-role": "error",
		"jsx_a11y/no-static-element-interactions": "error"
	},
	"overrides": [
		{
			"files": ["apps/nest-api/**/*.ts"],
			"rules": {
				"nextjs/google-font-display": "off",
				"nextjs/google-font-preconnect": "off",
				"nextjs/inline-script-id": "off",
				"nextjs/next-script-for-ga": "off",
				"nextjs/no-assign-module-variable": "off",
				"nextjs/no-async-client-component": "off",
				"nextjs/no-before-interactive-script-outside-document": "off",
				"nextjs/no-css-tags": "off",
				"nextjs/no-document-import-in-page": "off",
				"nextjs/no-duplicate-head": "off",
				"nextjs/no-head-element": "off",
				"nextjs/no-head-import-in-document": "off",
				"nextjs/no-html-link-for-pages": "off",
				"nextjs/no-img-element": "off",
				"nextjs/no-page-custom-font": "off",
				"nextjs/no-script-component-in-head": "off",
				"nextjs/no-styled-jsx-in-document": "off",
				"nextjs/no-sync-scripts": "off",
				"nextjs/no-title-in-document-head": "off",
				"nextjs/no-typos": "off",
				"nextjs/no-unwanted-polyfillio": "off",
				"react/button-has-type": "off",
				"react/capitalized-calls": "off",
				"react/checked-requires-onchange-or-readonly": "off",
				"react/display-name": "off",
				"react/error-boundaries": "off",
				"react/exhaustive-deps": "off",
				"react/exhaustive-effect-dependencies": "off",
				"react/forbid-component-props": "off",
				"react/forbid-dom-props": "off",
				"react/forbid-elements": "off",
				"react/forward-ref-uses-ref": "off",
				"react/function-component-definition": "off",
				"react/globals": "off",
				"react/hook-use-state": "off",
				"react/hooks": "off",
				"react/iframe-missing-sandbox": "off",
				"react/immutability": "off",
				"react/incompatible-library": "off",
				"react/invariant": "off",
				"react/jsx-boolean-value": "off",
				"react/jsx-curly-brace-presence": "off",
				"react/jsx-filename-extension": "off",
				"react/jsx-fragments": "off",
				"react/jsx-handler-names": "off",
				"react/jsx-key": "off",
				"react/jsx-max-depth": "off",
				"react/jsx-no-comment-textnodes": "off",
				"react/jsx-no-constructed-context-values": "off",
				"react/jsx-no-duplicate-props": "off",
				"react/jsx-no-literals": "off",
				"react/jsx-no-script-url": "off",
				"react/jsx-no-target-blank": "off",
				"react/jsx-no-undef": "off",
				"react/jsx-no-useless-fragment": "off",
				"react/jsx-pascal-case": "off",
				"react/jsx-props-no-spread-multi": "off",
				"react/jsx-props-no-spreading": "off",
				"react/memo-dependencies": "off",
				"react/no-array-index-key": "off",
				"react/no-children-prop": "off",
				"react/no-clone-element": "off",
				"react/no-danger": "off",
				"react/no-danger-with-children": "off",
				"react/no-deriving-state-in-effects": "off",
				"react/no-did-mount-set-state": "off",
				"react/no-did-update-set-state": "off",
				"react/no-direct-mutation-state": "off",
				"react/no-find-dom-node": "off",
				"react/no-is-mounted": "off",
				"react/no-multi-comp": "off",
				"react/no-namespace": "off",
				"react/no-object-type-as-default-prop": "off",
				"react/no-react-children": "off",
				"react/no-redundant-should-component-update": "off",
				"react/no-render-return-value": "off",
				"react/no-set-state": "off",
				"react/no-string-refs": "off",
				"react/no-this-in-sfc": "off",
				"react/no-unescaped-entities": "off",
				"react/no-unknown-property": "off",
				"react/no-unsafe": "off",
				"react/no-unstable-nested-components": "off",
				"react/no-will-update-set-state": "off",
				"react/only-export-components": "off",
				"react/prefer-es6-class": "off",
				"react/prefer-function-component": "off",
				"react/preserve-manual-memoization": "off",
				"react/purity": "off",
				"react/react-in-jsx-scope": "off",
				"react/refs": "off",
				"react/require-render-return": "off",
				"react/rule-suppression": "off",
				"react/rules-of-hooks": "off",
				"react/self-closing-comp": "off",
				"react/set-state-in-effect": "off",
				"react/set-state-in-render": "off",
				"react/state-in-constructor": "off",
				"react/static-components": "off",
				"react/style-prop-object": "off",
				"react/syntax": "off",
				"react/todo": "off",
				"react/unsupported-syntax": "off",
				"react/use-memo": "off",
				"react/void-dom-elements-no-children": "off",
				"react/void-use-memo": "off",
				"typescript/consistent-type-imports": "off",
				"typescript/no-explicit-any": "off",
				"typescript/no-floating-promises": "warn",
				"typescript/no-misused-promises": "warn",
				"unicorn/prefer-node-protocol": "error"
			}
		},
		{
			"files": ["apps/web/**/*.ts", "apps/web/**/*.tsx", "apps/docs/**/*.ts", "apps/docs/**/*.tsx"],
			"rules": {
				"nextjs/no-async-client-component": "warn",
				"nextjs/no-before-interactive-script-outside-document": "warn"
			}
		},
		{
			"files": ["packages/ui/src/components/*.tsx"],
			"excludeFiles": [
				"packages/ui/src/components/bottom-bar.tsx",
				"packages/ui/src/components/glass-card.tsx",
				"packages/ui/src/components/typeset.tsx"
			],
			"rules": {
				"jsx_a11y/label-has-associated-control": "off",
				"jsx_a11y/role-supports-aria-props": "off",
				"jsx_a11y/interactive-supports-focus": "off",
				"jsx_a11y/click-events-have-key-events": "off",
				"jsx_a11y/prefer-tag-over-role": "off",
				"react/exhaustive-deps": "off",
				"react/no-danger": "off",
				"react/no-array-index-key": "off",
				"unicorn/no-document-cookie": "off"
			}
		}
	]
}
