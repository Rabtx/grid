{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/.next",
    "**/dist",
    "**/*.md",
    "**/*.mdx",
    "**/*.mdc",
    "**/*.json",
    "**/*.jsonc",
    "**/*.json5",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.css",
    "**/*.scss",
    "**/*.less",
    "**/*.html",
    "**/*.graphql"
  ],
  "overrides": [
    {
      "files": [
        "apps/nest-api/**/*.ts"
      ],
      "options": {
        "singleQuote": true,
        "trailingComma": "all"
      }
    }
  ]
}
